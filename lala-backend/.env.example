# ── Lala Backend environment ─────────────────────────────────────────────
# Copy this file to `.env` for local dev. For production, set the SAME variables
# in the Render dashboard (Environment tab). NO secrets are hardcoded anywhere.

# ── Core ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# REQUIRED — Postgres connection string (Neon)
# e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# REQUIRED — long random string used to sign JWTs
JWT_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────
# REQUIRED — used for password-reset codes
RESEND_API_KEY=

# ── Lenco (mobile money collections + payouts) ─────────────────────────
# REQUIRED — Lenco API base URL. Confirm whether this points to the
# SANDBOX (test) or LIVE environment in your Lenco dashboard.
LENCO_API_URL=
# REQUIRED — Lenco API key (sk_...)
LENCO_API_KEY=
# REQUIRED — Lenco account id used for lodge/commission transfers
LENCO_ACCOUNT_ID=

# Commission split (safe defaults — optional)
LENCO_COMMISSION_RATE=0.10
LENCO_MIN_TRANSFER=5

# ── Commission wallet numbers (REQUIRED — never hardcoded) ─────────────
# The 10% service fee is sent to the wallet matching the operator the guest
# paid with. The app FAILS TO START if any of these are missing.
MTN_WALLET=
ZAMTEL_WALLET=
AIRTEL_WALLET=

# ── SMS (Africa's Talking) — OPTIONAL, service currently stubbed ───────
AT_USERNAME=
AT_API_KEY=

# ── Dev seed accounts (OPTIONAL — only used by scripts/seed-defaults.js) ─
SEED_ADMIN_EMAIL=admin@lala.com
SEED_ADMIN_PASSWORD=change-me
SEED_HOST_EMAIL=host@lala.com
SEED_HOST_PASSWORD=change-me
SEED_GUEST_EMAIL=guest@lala.com
SEED_GUEST_PASSWORD=change-me
